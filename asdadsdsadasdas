-- PLAYER BUTTONS
-- =====================
local selectedPlayer = nil
local stickActive = false

local function refresh()
    for _, v in ipairs(list:GetChildren()) do
        if v:IsA("TextButton") or (v:IsA("TextLabel") and v.Name == "EmptyLabel") then
            v:Destroy()
        end
    end

    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            count += 1
            local isSelected = (selectedPlayer == plr)

            local btn = Instance.new("TextButton")
            btn.Name = plr.Name
            btn.Size = UDim2.new(1, 0, 0, 32)
            btn.Text = ""
            btn.BackgroundColor3 = isSelected and Color3.fromRGB(50, 18, 120) or Color3.fromRGB(26, 14, 55)
            btn.BorderSizePixel = 0
            btn.ZIndex = 4
            btn.AutoButtonColor = false
            btn.Parent = list
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

            local btnStroke = Instance.new("UIStroke")
            btnStroke.Color = isSelected and Color3.fromRGB(140, 70, 255) or Color3.fromRGB(60, 28, 110)
            btnStroke.Thickness = 1
            btnStroke.Transparency = isSelected and 0 or 0.4
            btnStroke.Parent = btn

            local iconFrame = Instance.new("Frame")
            iconFrame.Size = UDim2.new(0, 20, 0, 20)
            iconFrame.Position = UDim2.new(0, 6, 0.5, -10)
            iconFrame.BackgroundColor3 = isSelected and Color3.fromRGB(120, 50, 255) or Color3.fromRGB(70, 32, 140)
            iconFrame.BorderSizePixel = 0
            iconFrame.ZIndex = 5
            iconFrame.Parent = btn
            Instance.new("UICorner", iconFrame).CornerRadius = UDim.new(1, 0)

            local iconTxt = Instance.new("TextLabel")
            iconTxt.Size = UDim2.new(1, 0, 1, 0)
            iconTxt.Text = string.upper(string.sub(plr.Name, 1, 1))
            iconTxt.TextColor3 = Color3.fromRGB(220, 185, 255)
            iconTxt.TextSize = 9
            iconTxt.Font = Enum.Font.GothamBold
            iconTxt.BackgroundTransparency = 1
            iconTxt.ZIndex = 6
            iconTxt.Parent = iconFrame

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Name = "NameLabel"
            nameLbl.Size = UDim2.new(1, -36, 1, 0)
            nameLbl.Position = UDim2.new(0, 32, 0, 0)
            nameLbl.Text = plr.Name
            nameLbl.TextColor3 = isSelected and Color3.fromRGB(220, 185, 255) or Color3.fromRGB(170, 145, 215)
            nameLbl.TextSize = 11
            nameLbl.Font = Enum.Font.Gotham
            nameLbl.BackgroundTransparency = 1
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.ZIndex = 5
            nameLbl.Parent = btn

            btn.MouseEnter:Connect(function()
                if selectedPlayer ~= plr then
                    TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(36, 20, 75)}):Play()
                end
            end)
            btn.MouseLeave:Connect(function()
                if selectedPlayer ~= plr then
                    TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(26, 14, 55)}):Play()
                end
            end)

            btn.MouseButton1Click:Connect(function()
                stickActive = false  -- cancel any active stick when manually changing target
                if selectedPlayer == plr then
                    selectedPlayer = nil
                    setStatus("No target selected")
                else
                    selectedPlayer = plr
                    setStatus("→ " .. plr.Name, Color3.fromRGB(155, 95, 255))
                end
                TweenService:Create(stroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(110, 55, 240), Transparency = 0.25}):Play()
                refresh()
            end)
        end
    end

    if count == 0 then
        local empty = Instance.new("TextLabel")
        empty.Name = "EmptyLabel"
        empty.Size = UDim2.new(1, 0, 0, 30)
        empty.Text = "No other players"
        empty.TextColor3 = Color3.fromRGB(80, 55, 115)
        empty.TextSize = 11
        empty.Font = Enum.Font.Gotham
        empty.BackgroundTransparency = 1
        empty.ZIndex = 4
        empty.Parent = list
    end

    task.wait()
    list.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 6)
end

refresh()

Players.PlayerAdded:Connect(function()
    task.wait(0.5)
    refresh()
end)
Players.PlayerRemoving:Connect(function(plr)
    if selectedPlayer == plr then
        selectedPlayer = nil
        setStatus("No target selected")
    end
    task.wait(0.1)
    refresh()
end)

-- =====================
-- SELECT CLOSEST LOGIC
-- =====================
local function selectClosestPlayer()
    local myChar = lp.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local closest = nil
    local closestDist = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        -- exclude local player by UserId AND by character reference to be safe
        if plr.UserId ~= lp.UserId and plr.Character and plr.Character ~= myChar then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp and hrp ~= myHRP then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = plr
                end
            end
        end
    end

    if closest then
        stickActive = false  -- cancel any active stick when auto-selecting closest
        selectedPlayer = closest
        setStatus("◎ Closest: " .. closest.Name, Color3.fromRGB(60, 220, 170))
        -- Flash the GUI stroke teal briefly
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 220, 170), Transparency = 0}):Play()
        task.delay(0.5, function()
            TweenService:Create(stroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(110, 55, 240), Transparency = 0.25}):Play()
        end)
        refresh()
    else
        setStatus("No players found", Color3.fromRGB(200, 80, 80))
    end
end

-- =====================
-- TELEPORT / STICK
-- =====================
RunService.RenderStepped:Connect(function()
    if stickActive and selectedPlayer and selectedPlayer.Character and lp.Character then
        local tHRP = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        local mHRP = lp.Character:FindFirstChild("HumanoidRootPart")
        if tHRP and mHRP then
            mHRP.CFrame = tHRP.CFrame * CFrame.new(STICK_OFFSET)
        end
    end
end)

UIS.InputBegan:Connect(function(input, gpe)
    if isBindingTP or isBindingSC then return end
    if gpe then return end

    -- Select Closest key (no gpe check so it always fires)
    if input.KeyCode == SELECT_CLOSEST_KEY then
        selectClosestPlayer()
        return
    end

    if input.KeyCode == TELEPORT_KEY then
        if selectedPlayer and selectedPlayer.Character and lp.Character then
            local tHRP = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
            local mHRP = lp.Character:FindFirstChild("HumanoidRootPart")
            if tHRP and mHRP then
                mHRP.CFrame = tHRP.CFrame * CFrame.new(STICK_OFFSET)
                stickActive = true
                setStatus("⬡ Sticking: " .. selectedPlayer.Name, Color3.fromRGB(90, 230, 160))
                TweenService:Create(stroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(80, 220, 150), Transparency = 0}):Play()
            end
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if isBindingTP or isBindingSC then return end
    if input.KeyCode == TELEPORT_KEY then
        stickActive = false
        if selectedPlayer then
            setStatus("→ " .. selectedPlayer.Name, Color3.fromRGB(155, 95, 255))
        else
            setStatus("No target selected")
        end
        TweenService:Create(stroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(110, 55, 240), Transparency = 0.25}):Play()
    end
end)
