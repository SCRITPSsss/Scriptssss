-- FRIENDS LIST (saved as JSON)
-- Players in this list are SKIPPED by Select Closest only
-- =====================
local FRIENDS_FILE = "playertp_friends.json"
local friendsSet = {}  -- { [lowercaseUsername] = true }

local function saveFriends()
    local arr = {}
    for name in pairs(friendsSet) do table.insert(arr, name) end
    pcall(function() writefile(FRIENDS_FILE, HttpService:JSONEncode(arr)) end)
end

local function loadFriends()
    local ok, data = pcall(function() return readfile(FRIENDS_FILE) end)
    if ok and data then
        local ok2, arr = pcall(function() return HttpService:JSONDecode(data) end)
        if ok2 and type(arr) == "table" then
            for _, name in ipairs(arr) do
                friendsSet[string.lower(tostring(name))] = true
            end
        end
    end
end

loadFriends()

local function isFriend(plr)
    return friendsSet[string.lower(plr.Name)] == true
end

local function toggleFriend(plr)
    local key = string.lower(plr.Name)
    if friendsSet[key] then
        friendsSet[key] = nil
    else
        friendsSet[key] = true
    end
    saveFriends()
end

