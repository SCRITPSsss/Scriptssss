    title.Font = Enum.Font.GothamBold
    title.BackgroundTransparency = 1
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.ZIndex = 4
    title.Parent = section

    local keyDisplay = Instance.new("Frame")
    keyDisplay.Size = UDim2.new(0, 70, 0, 22)
    keyDisplay.Position = UDim2.new(0, 8, 0, 22)
    keyDisplay.BackgroundColor3 = Color3.fromRGB(35, 18, 80)
    keyDisplay.BorderSizePixel = 0
    keyDisplay.ZIndex = 4
    keyDisplay.Parent = section
    Instance.new("UICorner", keyDisplay).CornerRadius = UDim.new(0, 6)

    local keyStroke = Instance.new("UIStroke")
    keyStroke.Color = accentColor
    keyStroke.Thickness = 1
    keyStroke.Transparency = 0.2
    keyStroke.Parent = keyDisplay

    local keyText = Instance.new("TextLabel")
    keyText.Size = UDim2.new(1, 0, 1, 0)
    keyText.Text = defaultKey.Name
    keyText.TextColor3 = Color3.fromRGB(200, 165, 255)
    keyText.TextSize = 11
    keyText.Font = Enum.Font.GothamBold
    keyText.BackgroundTransparency = 1
    keyText.ZIndex = 5
    keyText.Parent = keyDisplay

    local bindBtn = Instance.new("TextButton")
    bindBtn.Size = UDim2.new(0, 86, 0, 22)
    bindBtn.Position = UDim2.new(0, 82, 0, 22)
    bindBtn.Text = "REBIND"
    bindBtn.TextColor3 = Color3.fromRGB(200, 165, 255)
    bindBtn.TextSize = 10
    bindBtn.Font = Enum.Font.GothamBold
    bindBtn.BackgroundColor3 = accentDim
