    bindBtn.Parent = section
    Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0, 6)

    local bindBtnStroke = Instance.new("UIStroke")
    bindBtnStroke.Color = accentColor
    bindBtnStroke.Thickness = 1
    bindBtnStroke.Transparency = 0.3
    bindBtnStroke.Parent = bindBtn

    return section, keyText, bindBtn, bindBtnStroke, keyStroke, keyDisplay
end

