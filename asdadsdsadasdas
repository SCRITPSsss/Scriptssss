-- =====================
-- REFRESH (clears + rebuilds list)
-- =====================
refresh = function()
    for _, v in ipairs(list:GetChildren()) do
        if not v:IsA("UIListLayout") and not v:IsA("UIPadding") then
            v:Destroy()
        end
    end

    local query = string.lower(searchQuery)

    if currentTab == "PLAYERS" then
        local count = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.UserId ~= lp.UserId then
                local matchesSearch = query == ""
                    or string.find(string.lower(plr.Name), query, 1, true)
                    or string.find(string.lower(plr.DisplayName), query, 1, true)
                if matchesSearch then
                    count += 1
                    makePlayerRow(plr)
                end
            end
        end
        if count == 0 then
            local empty = Instance.new("TextLabel")
            empty.Name = "_empty"
            empty.Size = UDim2.new(1, 0, 0, 30)
            empty.Text = query ~= "" and "No results for \""..searchQuery.."\"" or "No other players"
            empty.TextColor3 = Color3.fromRGB(80, 55, 115)
            empty.TextSize = 10
            empty.Font = Enum.Font.Gotham
            empty.BackgroundTransparency = 1
            empty.ZIndex = 4
            empty.Parent = list
        end

    else -- FRIENDS tab
        local names = {}
        for name in pairs(friendsSet) do table.insert(names, name) end
        table.sort(names)

        local count = 0
        for _, name in ipairs(names) do
            local matchesSearch = query == "" or string.find(name, query, 1, true)
            if not matchesSearch then
                local plr = Players:FindFirstChild(name)
                if plr and string.find(string.lower(plr.DisplayName), query, 1, true) then
                    matchesSearch = true
                end
            end
            if matchesSearch then
                count += 1
                makeFriendRow(name)
            end
        end
        if count == 0 then
            local empty = Instance.new("TextLabel")
            empty.Name = "_empty"
            empty.Size = UDim2.new(1, 0, 0, 44)
            empty.Text = query ~= "" and "No results for \""..searchQuery.."\"" or "No friends added.\nPress + on a player to protect\nthem from Select Closest."
            empty.TextColor3 = Color3.fromRGB(65, 125, 85)
            empty.TextSize = 10
            empty.Font = Enum.Font.Gotham
            empty.BackgroundTransparency = 1
            empty.TextWrapped = true
            empty.ZIndex = 4
            empty.Parent = list
        end
    end

    task.wait()
    list.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 6)
end

