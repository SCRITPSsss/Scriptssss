local function makeBindSection(parent, yPos, labelText, defaultKey, accentColor, accentDim)
    local section = Instance.new("Frame")
    section.Size = UDim2.new(1, -12, 0, 50)
    section.Position = UDim2.new(0, 6, 0, yPos)
    section.BackgroundColor3 = Color3.fromRGB(20, 11, 48)
    section.BorderSizePixel = 0
    section.ZIndex = 3
    section.Parent = parent
    Instance.new("UICorner", section).CornerRadius = UDim.new(0, 8)

    local sectionStroke = Instance.new("UIStroke")
    sectionStroke.Color = Color3.fromRGB(65, 30, 120)
    sectionStroke.Thickness = 1
    sectionStroke.Transparency = 0.5
    sectionStroke.Parent = section

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -8, 0, 18)
    title.Position = UDim2.new(0, 8, 0, 4)
    title.Text = labelText
    title.TextColor3 = Color3.fromRGB(110, 80, 175)
